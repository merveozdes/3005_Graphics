          <attvalue for="metin" value="Boran_1943_sosyoloji"/>
          <attvalue for="ilişki türü" value="Atıf / kaynak ilişkisi"/>
          <attvalue for="kaynak metindeki açıklama" value="The Gang adlı eseriyle Şikago’daki suçlu çocuk gruplarında kıymetlerin oluşumunu inceleyen bir araştırmacı olarak belirtilmektedir."/>
        </attvalues>
      </edge>
      <edge id="2838" source="Boran" target="Muzaffer Şerif">
        <attvalues>
          <attvalue for="dönem" value="1923–1949"/>
          <attvalue for="metin" value="Boran_1943_sosyoloji"/>
          <attvalue for="ilişki türü" value="Atıf / kaynak ilişkisi"/>
          <attvalue for="kaynak metindeki açıklama" value="The Psychology of the Social Norms adlı eseriyle sosyal normların teşekkülünü laboratuvar ortamında inceleyen bir araştırmacı olarak anılmaktadır."/>
        </attvalues>
      </edge>
      <edge id="2839" source="Boran" target="J. F. Markey">
        <attvalues>
          <attvalue for="dönem" value="1923–1949"/>
          <attvalue for="metin" value="Boran_1943_sosyoloji"/>
          <attvalue for="ilişki türü" value="Atıf / kaynak ilişkisi"/>
          <attvalue for="kaynak metindeki açıklama" value="The Symbolic Process adlı eserin yazarı olarak, bilgi süreci ve sembolik süreçler bağlamında referans verilmektedir."/>
        </attvalues>
      </edge>
      <edge id="2840" source="Nusret Hızır" target="Hegel" weight="3.0">
        <attvalues>
          <attvalue for="dönem" value="1923–1949"/>
          <attvalue for="metin" value="Nusret Hızır'ın Hızır_1948_kavram3 başlıklı"/>
          <attvalue for="ilişki türü" value="Atıf / kaynak ilişkisi"/>
          <attvalue for="kaynak metindeki açıklama" value="&quot;Phaenomenologie des Geistes&quot; ve &quot;Wissenschaft der Logik&quot; adlı eserlerine atıfta bulunularak, sübjektif-objektif ikiliğine getirdiği diyalektik yorum bağlamında anılmaktadır."/>
        </attvalues>
      </edge>
      <edge id="2841" source="Nusret Hızır" target="Darwin">
        <attvalues>
          <attvalue for="dönem" value="1923–1949"/>
          <attvalue for="metin" value="Hızır_1944_bünye"/>
          <attvalue for="ilişki türü" value="Kavramsal / teorik referans"/>
          <attvalue for="kaynak metindeki açıklama" value="&quot;Darwinisme&quot; başlığı altında, tabii ayıklanma kavramı üzerinden bir düşünüş sistemi temsilcisi olarak geçmektedir."/>
        </attvalues>
      </edge>
      <edge id="2842" source="Nusret Hızır" target="Descartes">
        <attvalues>
          <attvalue for="dönem" value="1923–1949"/>
          <attvalue for="metin" value="Hızır_1944_bünye"/>
          <attvalue for="ilişki türü" value="Kavramsal / teorik referans"/>
          <attvalue for="kaynak metindeki açıklama" value="Felsefesindeki &quot;doğuştan (innées) fikirler&quot; kavramı üzerinden, kavramların kaynağı tartışmasında anılmaktadır."/>
        </attvalues>
      </edge>
      <edge id="2843" source="Nusret Hızır" target="Galilei" weight="2.0">
        <attvalues>
          <attvalue for="dönem" value="1923–1949"/>
          <attvalue for="metin" value="Nusret Hızır’ın Hızır_1947_formelleştirme başlıklı"/>
          <attvalue for="ilişki türü" value="Kavramsal / teorik referans"/>
          <attvalue for="kaynak metindeki açıklama" value="Fizik alanındaki çalışmalarıyla, iki hakikat-değerli mantık sistemine örnek teşkil eden &quot;Galilei-Newton fiziği&quot; bağlamında anılmaktadır."/>
        </attvalues>
      </edge>
      <edge id="2844" source="Nusret Hızır" target="Kepler">
        <attvalues>
          <attvalue for="dönem" value="1923–1949"/>
          <attvalue for="metin" value="Hızır_1944_bünye"/>
          <attvalue for="ilişki türü" value="Kavramsal / teorik referans"/>
          <attvalue for="kaynak metindeki açıklama" value="Newton'un evrensel çekim kanunu ile ilişkilendirilen gök sistemi sahibi olarak anılmaktadır."/>
