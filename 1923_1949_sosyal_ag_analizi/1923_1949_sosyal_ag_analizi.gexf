          <attvalue for="metin" value="Boran_1943_sosyoloji"/>
          <attvalue for="ilişki türü" value="Kavramsal / teorik referans"/>
          <attvalue for="kaynak metindeki açıklama" value="Alman mektebinde yer alan, manevi bilimler-tabii bilimler ayrımını savunan ve protestanlık ile kapitalizm arasındaki ilişkiyi inceleyen bir sosyolog olarak anılmaktadır."/>
        </attvalues>
      </edge>
