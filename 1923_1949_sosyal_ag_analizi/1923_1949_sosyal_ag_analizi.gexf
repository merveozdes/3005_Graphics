          <attvalue for="metin" value="Boran_1943_sosyoloji"/>
          <attvalue for="ilişki türü" value="Kavramsal / teorik referans"/>
          <attvalue for="kaynak metindeki açıklama" value="Alman mektebinde yer alan ve manevi bilimler-tabii bilimler ayrımını savunan düşünürlerden biri olarak belirtilmektedir."/>
        </attvalues>
      </edge>
