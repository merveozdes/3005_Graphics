          <attvalue for="ilişki türü" value="Kavramsal / teorik referans"/>
          <attvalue for="kaynak metindeki açıklama" value="Manevi bilimler ve tabii bilimler ayrımını yapan, sosyolojideki ikilik görüşünü savunan Alman mektebi temsilcilerinden biri olarak anılmaktadır."/>
        </attvalues>
      </edge>
