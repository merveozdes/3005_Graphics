          <attvalue for="kaynak metindeki açıklama" value="Le jugement moral chez l'enfant adlı eseriyle çocuk gruplarında kaidelerin nasıl doğduğunu gösteren bir araştırmacı olarak anılmaktadır."/>
        </attvalues>
      </edge>
      <edge id="2837" source="Boran" target="F. Thrasher">
        <attvalues>
