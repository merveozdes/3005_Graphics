          <attvalue for="metin" value="Boran_1943_sosyoloji"/>
          <attvalue for="ilişki türü" value="Kavramsal / teorik referans"/>
          <attvalue for="kaynak metindeki açıklama" value="Amerika’da sosyolojinin müsbet bir bilim olamayacağı fikrini savunan ve &quot;bütüncülük&quot; görüşünü öne süren bir sosyolog olarak belirtilmektedir."/>
